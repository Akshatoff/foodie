# Rename this file to .env and add your key.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the JS bundle.
# NOTE: bundling the key client-side means it is extractable from the app
# binary. For production, proxy Gemini calls through your own backend
# instead of calling the API directly from the client.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
